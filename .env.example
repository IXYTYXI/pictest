# Run ./scripts/init.sh --public-url https://images.example.com to generate .env.
# .env contains no upload token. The token stays in .secrets/upload_token.
PUBLIC_BASE_URL=http://localhost:8080
SITE_ADDRESS=localhost
BIND_HOST=127.0.0.1
HTTP_PORT=8080
COMPOSE_PROJECT_NAME=upic
DATA_VOLUME_NAME=upic_images
MAX_UPLOAD_BYTES=10485760
MAX_STORAGE_BYTES=10737418240
MAX_IMAGE_PIXELS=20000000
MAX_CONCURRENT_UPLOADS=2
MAX_REQUEST_BYTES=16MB
CPU_LIMIT=1.0
MEMORY_LIMIT=512m
GOMEMLIMIT=384MiB
