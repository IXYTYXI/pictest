# Compatible with Awesome Deploy's restricted, offline Dockerfile builder.
FROM golang:1.26.4-alpine@sha256:3ad57304ad93bbec8548a0437ad9e06a455660655d9af011d58b993f6f615648 AS builder
WORKDIR /src
COPY go.mod ./
COPY cmd ./cmd
COPY internal ./internal
ENV CGO_ENABLED=0 GOTOOLCHAIN=local
RUN go build -trimpath -ldflags="-s -w" -o /out/upic-server ./cmd/upic-server

FROM alpine:3.23@sha256:85fe1e81d6758c208f3e1eed4338a1997e19d4be002d4dd32d3100c9a8c010a0
# Docker initializes a new named volume with this directory's ownership.
RUN mkdir -p /data && chown 65532:65532 /data && chmod 0700 /data
COPY --from=builder /out/upic-server /upic-server
USER 65532:65532
EXPOSE 8080
ENTRYPOINT ["/upic-server"]
